// DOM elements
const startExerciseBtn = document.getElementById('startExerciseBtn');
const pauseExerciseBtn = document.getElementById('pauseExerciseBtn');
const resetExerciseBtn = document.getElementById('resetExerciseBtn');
const timerDisplay = document.getElementById('exercise-timer');
const exerciseNameDisplay = document.getElementById('exerciseName');
const exerciseDescriptionDisplay = document.getElementById('exerciseDescription');
const exerciseProgress = document.getElementById('progress-bar');
const currentStepText = document.getElementById('currentStepText');
const currentStepSpan = document.getElementById('currentStep');
const totalStepsSpan = document.getElementById('totalSteps');
const exerciseList = document.getElementById('exerciseList');
const animationContainer = document.getElementById('animation');
const trackingStatus = document.getElementById('tracking-status');
const trackingMessage = document.getElementById('tracking-message');

// Exercise state
let activeEyeExerciseType = 'twenty-twenty-twenty'; // Default exercise
let currentExercise = exercises['twenty-twenty-twenty'];
let currentStepIndex = 0;
let timeLeftInStep = 0;
let totalTimeElapsed = 0;
let timerInterval;
let isPaused = false;
let trackingActive = false;
let trackingResults = [];

// Function to update UI based on current exercise and step
function updateUI() {
    if(!currentExercise) return;

    // Update exercise name and description
    const selectedExerciseItem = document.querySelector(`.list-group-item[data-exercise="${activeEyeExerciseType}"]`);
    if(selectedExerciseItem){
        const name = selectedExerciseItem.querySelector('h6').textContent;
        const description = selectedExerciseItem.querySelector('p').textContent;
        // You might want to display this info somewhere
        // For now, we'll just log it
        console.log(`Current Exercise: ${name} - ${description}`);
    }

    if(totalStepsSpan) totalStepsSpan.textContent = currentExercise.steps.length;
    if(currentStepSpan) currentStepSpan.textContent = currentStepIndex + 1;
    if(currentStepText) currentStepText.textContent = currentExercise.steps[currentStepIndex].text;

    // Update progress bar
    const progressPercentage = (totalTimeElapsed / currentExercise.duration) * 100;
    if(exerciseProgress) exerciseProgress.style.width = `${progressPercentage}%`;

    // Update timer display
    const minutes = Math.floor(totalTimeElapsed / 60);
    const seconds = totalTimeElapsed % 60;
    if(timerDisplay) timerDisplay.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;

    // Update animation
    if(currentExercise.animation) currentExercise.animation(currentStepIndex);

    // Update tracking for current step
    const step = currentExercise.steps[currentStepIndex];
    if (trackingActive && step.tracking) {
        updateTrackingFeedback(step.tracking);
    }
}

// Function to start the exercise
function startExercise() {
    if (!currentExercise) return;

    // Enable/disable buttons
    if(startExerciseBtn) startExerciseBtn.disabled = true;
    if(pauseExerciseBtn) pauseExerciseBtn.disabled = false;
    if(resetExerciseBtn) resetExerciseBtn.disabled = false;

    if (isPaused) {
        isPaused = false;
    } else {
        currentStepIndex = 0;
        totalTimeElapsed = 0;
        timeLeftInStep = currentExercise.steps[currentStepIndex].duration;
        updateUI();
        if (window.startEyeExercise) {
            window.startEyeExercise();
        }
    }

    timerInterval = setInterval(() => {
        if (isPaused) return;

        timeLeftInStep--;
        totalTimeElapsed++;

        if (timeLeftInStep <= 0) {
            currentStepIndex++;
            if (currentStepIndex < currentExercise.steps.length) {
                timeLeftInStep = currentExercise.steps[currentStepIndex].duration;
            } else {
                clearInterval(timerInterval);
                endExercise();
                return;
            }
        }
        updateUI();
    }, 1000);
}

// Function to pause the exercise
function pauseExercise() {
    isPaused = true;
    clearInterval(timerInterval);
    if(startExerciseBtn) startExerciseBtn.disabled = false;
    if(pauseExerciseBtn) pauseExerciseBtn.disabled = true;
    if (window.stopEyeExercise) {
        window.stopEyeExercise();
    }
}

// Function to reset the exercise
function resetExercise() {
    clearInterval(timerInterval);

    isPaused = false;
    currentStepIndex = 0;
    totalTimeElapsed = 0;

    if(currentExercise){
        timeLeftInStep = currentExercise.steps[currentStepIndex].duration;
    }
    
    trackingActive = false;
    trackingResults = [];

    updateUI();
    if(startExerciseBtn) startExerciseBtn.disabled = false;
    if(pauseExerciseBtn) pauseExerciseBtn.disabled = true;
    if(resetExerciseBtn) resetExerciseBtn.disabled = true;

    if (window.stopEyeExercise) {
        window.stopEyeExercise();
    }
}

// Function to end the exercise
function endExercise() {
    activeEyeExerciseType = null;
    clearInterval(timerInterval);
    if(startExerciseBtn) startExerciseBtn.disabled = false;
    if(pauseExerciseBtn) pauseExerciseBtn.disabled = true;
    if(resetExerciseBtn) resetExerciseBtn.disabled = true;
    if(currentStepText) currentStepText.textContent = 'Exercise Completed!';
    if(exerciseProgress) exerciseProgress.style.width = '100%';

    if (window.stopEyeExercise) {
        window.stopEyeExercise();
    }

    trackingActive = false;
}

// Event Listeners
if(startExerciseBtn) startExerciseBtn.addEventListener('click', startExercise);
if(pauseExerciseBtn) pauseExerciseBtn.addEventListener('click', pauseExercise);
if(resetExerciseBtn) resetExerciseBtn.addEventListener('click', resetExercise);

if(exerciseList){
    exerciseList.addEventListener('click', (event) => {
        const button = event.target.closest('.list-group-item-action');
        if (button) {
            document.querySelectorAll('.list-group-item-action').forEach(btn => {
                btn.classList.remove('active');
            });
            button.classList.add('active');
            activeEyeExerciseType = button.dataset.exercise;
            currentExercise = exercises[activeEyeExerciseType];
            resetExercise();
        }
    });
}


