            --danger-color: #e76f51;
            --light-bg: #f8f9fa;
            --dark-bg: #212529;
            --card-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);
            --transition-speed: 0.3s;
        }

        body {
            background-color: var(--light-bg);
            overflow-x: hidden;
        }

        #exercise-area {
            min-height: 500px;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border-radius: 15px;
            transition: background-color var(--transition-speed);
            overflow: hidden;
            position: relative;
        }

        #exercise-area.active {
            background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
        }

        #animation {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            width: 100%;
            transition: all var(--transition-speed);
        }

        #target {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: radial-gradient(circle, #dc3545 0%, #c82333 100%);
            box-shadow: 0 0 20px rgba(220, 53, 69, 0.6);
            transition: all 0.3s ease;
            position: absolute;
            z-index: 5;
            display: none;
            border: 3px solid white;
            cursor: none;
        }

        #target.target-focused {
            background: radial-gradient(circle, #28a745 0%, #1e7e34 100%);
            box-shadow: 0 0 30px rgba(40, 167, 69, 0.8);
            transform: scale(1.2);
            animation: success-pulse 0.5s ease-in-out;
